{
  "name": "ai-harness-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:no-prerender",
    "build:with-prerender": "npm run sitemap && tsc -b && vite build && npm run prerender",
    "build:analyze": "npm run sitemap && tsc -b && vite build --mode analyze && npm run prerender",
    "build:no-prerender": "npm run sitemap && tsc -b && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^148.0.0",
    "@tailwindcss/vite": "^4.0.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer": "^24.43.0",
    "puppeteer-core": "^24.43.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
